// Prisma schema file for email-service backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GmailConnection {
  id           String   @id @default(uuid())
  userId       String   @unique
  email        String
  accessToken  String
  refreshToken String?
  tokenType    String?
  scope        String?
  expiryDate   BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("gmail_connections")
}

model Candidate {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  fullName     String
  email        String   @unique
  projectTitle String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("candidates")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}
